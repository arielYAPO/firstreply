NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
SIGNUP_WEBHOOK_SECRET=
ADMIN_NOTIFICATION_EMAIL=
# Adresse d'un domaine vérifié dans Resend, par exemple :
# FirstReply <bonjour@updates.firstreply.fr>
RESEND_FROM_EMAIL=
# Facultatif : les réponses des utilisateurs seront envoyées à cette adresse.
RESEND_REPLY_TO_EMAIL=
# Requis pour les routes /api/admin/* — sans cette variable, elles refusent tout accès
ADMIN_SECRET=

# PayPal REST Checkout
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
